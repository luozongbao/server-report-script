# Server Report Scripts — environment configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# The scripts AUTO-LOAD this file at startup, in this order:
#   1. $REPORT_ENV_FILE              (explicit override)
#   2. $PWD/.env                     (project-local — most common)
#   3. $HOME/.config/server-report-script/.env
#   4. /etc/server-report-script.env (system-wide)
#
# You do NOT need `set -a && source .env && set +a`. Just run:
#   sudo ./server-attack-report.sh 24h
#
# To disable auto-loading, set REPORTS_NO_AUTOLOAD=1.
# To debug which file was loaded, set REPORT_ENV_DEBUG=1.
# This file is gitignored (except .env.example).

# ---------- Recipients --------------------------------------------------
# Comma-separated. Used when no --email flag is given. Repeat --email to
# add more recipients on the command line.
REPORT_EMAIL="ops@example.com,security@example.com"

# ---------- Sender ------------------------------------------------------
# Default From: address. Leave blank to use root@<hostname>.
REPORT_SENDER="server-reports@example.com"

# ---------- Mailer ------------------------------------------------------
# Force a specific mailer. If unset, scripts auto-detect in this order:
#   msmtp → mail → mailx → sendmail
# EMAIL_CMD=msmtp
# EMAIL_CMD=/usr/sbin/sendmail

# ---------- msmtp-specific ---------------------------------------------
# If you use msmtp with multiple accounts in ~/.msmtprc, set the account
# name here. The script will pass `-a <account>` to msmtp.
MSMTP_ACCOUNT="default"

# Optional: override the msmtp config path (passed as -C). Leave blank
# to use msmtp's default search paths.
# MSMTP_CONFIG=/home/zongbao/.msmtprc

# ---------- Library location -------------------------------------------
# If scripts are installed to a system path and `lib/common.sh` is in a
# different location, point LIB_DIR at the directory that contains
# common.sh. Leave blank to use the script-relative path or the standard
# install locations (/usr/local/share/server-report-script/lib,
# /usr/share/server-report-script/lib).
# LIB_DIR=/usr/local/share/server-report-script/lib

# ---------- Examples for common setups ---------------------------------
# msmtp via Gmail SMTP relay:
#   EMAIL_CMD=msmtp
#   MSMTP_ACCOUNT=gmail
#   REPORT_SENDER=alerts@gmail.com
#   REPORT_EMAIL=ops@example.com
#
# Local MTA only (mail/mailx → Postfix):
#   EMAIL_CMD=/usr/bin/mail
#   REPORT_SENDER=root
#   REPORT_EMAIL=ops@example.com