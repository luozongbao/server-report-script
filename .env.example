# Server Report Scripts — environment configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Then export it before running a script:
#   set -a; source .env; set +a
#   sudo ./server-attack-report.sh 24h
#
# Or load it directly inside a sudo call:
#   sudo bash -c "set -a; source /path/to/.env; set +a; ./server-attack-report.sh 24h"
#
# Anything in `.env` is consumed via standard env-var lookups; nothing is
# written to disk by the scripts beyond their own /tmp files.

# ---------- Recipients --------------------------------------------------
# Comma-separated. Used when no --email flag is given. Repeat --email to
# add more recipients on the command line.
REPORT_EMAIL="ops@example.com,security@example.com"

# ---------- Sender ------------------------------------------------------
# Default From: address. Leave blank to use root@<hostname>.
REPORT_SENDER="server-reports@example.com"

# ---------- Mailer ------------------------------------------------------
# Force a specific mailer. If unset, scripts auto-detect in this order:
#   msmtp → mail → mailx → sendmail
# EMAIL_CMD=msmtp
# EMAIL_CMD=/usr/sbin/sendmail

# ---------- msmtp-specific ---------------------------------------------
# If you use msmtp with multiple accounts in ~/.msmtprc, set the account
# name here. The script will pass `-a <account>` to msmtp.
MSMTP_ACCOUNT="default"

# Optional: override the msmtp config path (passed as -C). Leave blank
# to use msmtp's default search paths.
# MSMTP_CONFIG=/etc/msmtprc

# ---------- Examples for common setups ---------------------------------
# msmtp via Gmail SMTP relay:
#   EMAIL_CMD=msmtp
#   MSMTP_ACCOUNT=gmail
#   REPORT_SENDER=alerts@gmail.com
#   REPORT_EMAIL=ops@example.com
#
# Local MTA only (mail/mailx → Postfix):
#   EMAIL_CMD=/usr/bin/mail
#   REPORT_SENDER=root
#   REPORT_EMAIL=ops@example.com